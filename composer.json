{
  "name": "lesname/cache",
  "license": "MIT",
  "require": {
    "php": "^8.4.0",

    "psr/simple-cache": "^3.0.0",
    "psr/container": "^2.0.0"
  },
  "require-dev": {
    "ext-redis": "*",

    "squizlabs/php_codesniffer": "^3.6.0",
    "phpstan/phpstan": "^2.0.0",
    "phpunit/phpunit": "^10.0.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "LesCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesCacheTest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
